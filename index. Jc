const { Telegraf, Markup } = require('telegraf');

const token = process.env.BOT_TOKEN;
const adminId = Number(process.env.ADMIN_ID || 0);
const paymentInfo = process.env.PAYMENT_INFO || 'BaridiMob RIP: 00799999000000000000';

if (!token) {
  console.error('BOT_TOKEN is missing!');
  process.exit(1);
}

const bot = new Telegraf(token);
const sessions = new Map();
const orders = new Map();

bot.start((ctx) => {
  sessions.delete(ctx.from.id);
  return ctx.reply(
    'مرحباً بك في نظام الشحن.\nاضغط على الزر بالأسفل للبدء:',
    Markup.keyboard([['💳 شحن الحساب']]).resize()
  );
});

bot.hears('💳 شحن الحساب', (ctx) => {
  sessions.set(ctx.from.id, { step: 'awaiting_id' });
  return ctx.reply('أدخل رقم الحساب (ID) المراد شحنه:');
});

bot.on('text', (ctx) => {
  const session = sessions.get(ctx.from.id);
  if (!session) return;

  const text = ctx.message.text.trim();

  if (session.step === 'awaiting_id') {
    session.accountId = text;
    session.step = 'awaiting_amount';
    return ctx.reply('أدخل المبلغ المراد شحنه:');
  }

  if (session.step === 'awaiting_amount') {
    session.amount = text;
    session.step = 'awaiting_receipt';
    return ctx.reply(
      `${paymentInfo}\n\nقم بتحويل مبلغ *${text}* ثم أرسل *صورة وصل الدفع* هنا:`,
      { parse_mode: 'Markdown' }
    );
  }
});

bot.on('photo', async (ctx) => {
  const userId = ctx.from.id;
  const session = sessions.get(userId);

  if (!session || session.step !== 'awaiting_receipt') {
    return ctx.reply('يرجى الضغط على "💳 شحن الحساب" أولاً.');
  }

  const orderId = `ORD${Date.now()}`;
  const photoId = ctx.message.photo[ctx.message.photo.length - 1].file_id;

  orders.set(orderId, {
    userId,
    accountId: session.accountId,
    amount: session.amount,
    status: 'pending'
  });

  const caption =
    `📥 *طلب شحن جديد*\n\n` +
    `🔖 رقم الطلب: \`${orderId}\`\n` +
    `👤 المستخدم: \`${userId}\`\n` +
    `🆔 رقم الحساب: \`${session.accountId}\`\n` +
    `💰 المبلغ: \`${session.amount}\``;

  if (adminId) {
    await ctx.telegram.sendPhoto(adminId, photoId, {
      caption,
      parse_mode: 'Markdown',
      ...Markup.inlineKeyboard([
        [
          Markup.button.callback('✅ تأكيد الشحن', `approve_${orderId}`),
          Markup.button.callback('❌ رفض الطلب', `reject_${orderId}`)
        ]
      ])
    });
  }

  sessions.delete(userId);
  return ctx.reply('⏳ تم إرسال طلبك للمراجعة. سيتم إشعارك فور التنفيذ.');
});

bot.action(/^(approve|reject)_(.+)$/, async (ctx) => {
  if (ctx.from.id !== adminId) {
    return ctx.answerCbQuery('غير مصرح لك.', { show_alert: true });
  }

  const action = ctx.match[1];
  const orderId = ctx.match[2];
  const order = orders.get(orderId);

  if (!order || order.status !== 'pending') {
    return ctx.answerCbQuery('الطلب غير متاح أو تمت معالجته.', { show_alert: true });
  }

  if (action === 'approve') {
    order.status = 'approved';
    await ctx.telegram.sendMessage(
      order.userId,
      `✅ تم تأكيد شحن الحساب \`${order.accountId}\` بمبلغ *${order.amount}* بنجاح!`,
      { parse_mode: 'Markdown' }
    );
    await ctx.editMessageCaption(
      `✅ *تم تأكيد الطلب* (\`${orderId}\`)\n🆔 الحساب: \`${order.accountId}\` | 💰 المبلغ: \`${order.amount}\``,
      { parse_mode: 'Markdown' }
    );
    return ctx.answerCbQuery('تم التأكيد.');
  } else {
    order.status = 'rejected';
    await ctx.telegram.sendMessage(
      order.userId,
      `❌ تم رفض طلب الشحن رقم \`${orderId}\`. يرجى التأكد من الوصل والمحاولة مجدداً.`,
      { parse_mode: 'Markdown' }
    );
    await ctx.editMessageCaption(
      `❌ *تم رفض الطلب* (\`${orderId}\`)\n🆔 الحساب: \`${order.accountId}\` | 💰 المبلغ: \`${order.amount}\``,
      { parse_mode: 'Markdown' }
    );
    return ctx.answerCbQuery('تم الرفض.');
  }
});

bot.launch().then(() => console.log('Bot is running...'));
process.once('SIGINT', () => bot.stop('SIGINT'));
process.once('SIGTERM', () => bot.stop('SIGTERM'));
